datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  googleId      String?
  accessToken   String?
  refreshToken  String?
  tokenExpiry   DateTime?
  retentionDays Int       @default(30)
  isDemo        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  connectedAccounts ConnectedAccount[]
  emails            Email[]
  calendarEvents    CalendarEvent[]
  tasks             TaskItem[]
  notifications     NotificationLog[]
  pushSubscriptions PushSubscription[]
  preferences       UserPreference[]
  interactions      InteractionHistory[]
}

model ConnectedAccount {
  id           String    @id @default(cuid())
  userId       String
  email        String
  name         String?
  avatar       String?
  color        String?   // Accent color for indicator dot
  initials     String?   // Short 2-letter badge e.g. "AC", "AP"
  accessToken  String?   // AES-256-GCM encrypted
  refreshToken String?   // AES-256-GCM encrypted
  expiresAt    DateTime?
  isPrimary    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails         Email[]
  calendarEvents CalendarEvent[]
  tasks          TaskItem[]

  @@unique([userId, email])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Email {
  id                 String    @id @default(cuid())
  userId             String
  connectedAccountId String?
  accountEmail       String?
  googleMessageId    String?
  threadId           String?
  sender             String
  senderName         String?
  recipient          String
  subject            String
  snippet            String?
  bodyText           String?
  bodyHtml           String?
  receivedAt         DateTime  @default(now())
  summary            String
  isActionable       Boolean   @default(false)
  actionType         String    @default("none") // "event", "task", "none"
  eventProposal      String?   // JSON string: { title, startTime, endTime, location, description }
  taskProposal       String?   // JSON string: { title, dueDate, notes, priority }
  status             String    @default("inbox") // "inbox", "archived", "trash"
  briefingStatus     String    @default("pending") // "pending", "interested", "dismissed", "actioned"
  isRead             Boolean   @default(false)
  isMock             Boolean   @default(false)
  tags               String    @default("[]") // JSON string array e.g. ["Work", "Urgent"]
  category           String?   @default("General") // Learned or classified category
  priority           String?   @default("medium") // "critical", "high", "medium", "low", "ignore"
  personalizationReason String? // Human-readable explanation of why priority/action was chosen
  personalizationConfidence Float? // 0.0 - 1.0 confidence score
  bodyPurgedAt       DateTime? // Timestamp if raw body was auto-purged
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  calendarEvents   CalendarEvent[]
  tasks            TaskItem[]
  notifications    NotificationLog[]
  interactions     InteractionHistory[]

  @@index([userId, status])
  @@index([userId, briefingStatus])
  @@index([userId, priority])
  @@index([connectedAccountId])
}

model CalendarEvent {
  id                 String   @id @default(cuid())
  userId             String
  connectedAccountId String?
  emailId            String?
  googleEventId      String?
  calendarId         String?  @default("primary")
  title              String
  description        String?
  location           String?
  startTime          DateTime
  endTime            DateTime
  htmlLink           String?
  createdAt          DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  email            Email?            @relation(fields: [emailId], references: [id], onDelete: SetNull)
}

model TaskItem {
  id                 String    @id @default(cuid())
  userId             String
  connectedAccountId String?
  emailId            String?
  googleTaskId       String?
  taskListId         String?   @default("@default")
  title              String
  notes              String?
  due                DateTime?
  status             String    @default("needsAction")
  isCompleted        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  email            Email?            @relation(fields: [emailId], references: [id], onDelete: SetNull)
}

model NotificationLog {
  id                 String   @id @default(cuid())
  userId             String
  connectedAccountId String?
  emailId            String?
  title              String
  message            String
  summary            String?
  isRead             Boolean  @default(false)
  createdAt          DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  email Email? @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id               String   @id @default(cuid())
  userId           String
  type             String   // "category" | "sender" | "action"
  key              String   // e.g. "college", "shopping", "internship", "professor@univ.edu", "deadline"
  score            Float    @default(0.5) // Normalized score: 0.0 (IGNORE) to 1.0 (CRITICAL)
  confidence       Float    @default(0.1) // 0.0 to 1.0
  interactionCount Int      @default(0)
  preferredAction  String?  // "task" | "event" | "none"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
  @@index([userId, type])
}

model InteractionHistory {
  id                  String   @id @default(cuid())
  userId              String
  emailId             String?
  category            String?
  sender              String?
  aiPredictedPriority String?  // "low" | "medium" | "high" | "critical" | "ignore"
  aiPredictedAction   String?  // "task" | "event" | "none"
  userFeedback        String?  // "low" | "medium" | "high" | "critical" | "ignore" | "task_created" | "event_created" | "dismissed"
  feedbackType        String   // "explicit_priority" | "implicit_task" | "implicit_calendar" | "implicit_dismiss"
  explanation         String?  // Human-readable learning context
  createdAt           DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  email Email? @relation(fields: [emailId], references: [id], onDelete: SetNull)

  @@index([userId, feedbackType])
  @@index([userId, category])
  @@index([userId, sender])
}

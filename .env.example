# Database (Prisma + SQLite)
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generated-nextauth-secret"

# At-Rest Token Encryption Key (32-byte / 64-hex string for AES-256-GCM)
TOKEN_ENCRYPTION_KEY="your-32-byte-hex-encryption-key"

# Google Cloud OAuth Credentials (Optional for Demo Mode)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Groq API / Gemini API Key (Optional for Demo Mode)
GROQ_API_KEY="your-groq-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# SerpApi Key for Real-Time Web Context & Topic Intelligence (Free tier at serpapi.com)
SERPAPI_API_KEY="your-serpapi-api-key"

